        // one consistent lock set.
{%- for eid, ent in s.entities %}
        let g_{{ ent.snake_name }}s = read_or_recover(&self.{{ ent.snake_name }}s);
{%- endfor %}
{%- for eid, ent in s.entities %}
{%- for rid, r in s.entities[eid].forward_relationships %}

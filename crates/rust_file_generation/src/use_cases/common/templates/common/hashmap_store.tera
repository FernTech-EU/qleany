{%- endfor %}
{%- endfor %}
        let g_counters = read_or_recover(&self.counters);

        HashMapStore {
{%- for eid, ent in s.entities %}
            {{ ent.snake_name }}s: RwLock::new(g_{{ ent.snake_name }}s.clone()),
{%- endfor %}
{%- for eid, ent in s.entities %}
{%- for rid, r in s.entities[eid].forward_relationships %}
            jn_{{ s.entities[r.inner.right_entity].snake_name }}_from_{{ ent.snake_name }}_{{ r.field_snake_name }}: RwLock::new(g_jn_{{ s.entities[r.inner.right_entity].snake_name }}_from_{{ ent.snake_name }}_{{ r.field_snake_name }}.clone()),
{%- endfor %}
{%- endfor %}
            counters: RwLock::new(g_counters.clone()),
            savepoints: RwLock::new(std::collections::HashMap::new()),
            next_savepoint_id: RwLock::new(0),

{%- if s.entities[e].owner %}
    pub fn get_relationships_from_owner(&self, owner_id: &EntityId) -> Result<Vec<EntityId>, RepositoryError> {
        let repo = repository_factory::write::create_{{ s.entities[e].owner_snake_name }}_repository(self.transaction)?;
        repo.get_relationship(
            owner_id,

{%- endif %}

    pub fn snapshot(&self, ids: &[EntityId]) -> Result<EntityTreeSnapshot, RepositoryError> {
        // O(1) whole-store capture (im::HashMap structural sharing). Restore is scoped to `ids`.
        let store_snap = self.transaction.snapshot_store();
        Ok(EntityTreeSnapshot { store_snapshot: Some(store_snap), root_ids: ids.to_vec() })
    }

    pub fn restore(&mut self, event_buffer: &mut EventBuffer, snap: &EntityTreeSnapshot) -> Result<(), RepositoryError> {
        let store_snap = snap.store_snapshot.as_ref()
            .ok_or_else(|| RepositoryError::Serialization("missing store snapshot".into()))?;
        let snap_store = store_snap.downcast_ref::<HashMapStoreSnapshot>()
            .ok_or_else(|| RepositoryError::Serialization("snapshot type mismatch".into()))?;

        // Scoped restore: walk the subtree rooted at the captured ids (strong relationships only),
        // in both the snapshot and the live store, and reconcile only it.
        let mut visited = std::collections::HashSet::new();
        self.restore_subtree(event_buffer, snap_store, &snap.root_ids, &mut visited)?;
{%- for rid, r in s.entities[e].backward_relationships %}
{%- if r.inner.strength == "Strong" %}

        // Surgically reconcile the root ids' placement in their (external) strong owner,
        // preserving sibling edits made on other undo stacks.
        self.reconcile_backref_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }}(event_buffer, snap_store, &snap.root_ids)?;
{%- endif %}
{%- endfor %}

        Ok(())
    }

    /// Restore the subtree rooted at `ids` (of this entity type) to the snapshot state, recursing
    /// into strong children. Touches only the subtree: in-scope rows and the forward junctions they
    /// own are restored wholesale; external referrers are reconciled surgically; everything else
    /// (other trunks, non-undoable data) is left untouched. `visited` guards against cycles.
    pub(crate) fn restore_subtree(
        &self,
        event_buffer: &mut EventBuffer,
        snap: &HashMapStoreSnapshot,
        ids: &[EntityId],
        // Keyed by (entity type, id): EntityIds are per-type, not globally unique, so a bare
        // id set would let one entity type's id falsely mask another's.
        visited: &mut std::collections::HashSet<(&'static str, EntityId)>,
    ) -> Result<(), RepositoryError> {
        let ids: Vec<EntityId> = ids
            .iter()
            .copied()
            .filter(|id| visited.insert(("{{ s.entities[e].snake_name }}", *id)))
            .collect();
        if ids.is_empty() {
            return Ok(());
        }

        let store = self.transaction.get_store();

        // Three-way partition by presence in snapshot vs live store (read before mutating).
        let mut to_create: Vec<EntityId> = Vec::new(); // in snapshot, gone from live -> re-add
        let mut to_update: Vec<EntityId> = Vec::new(); // in both                    -> revert
        let mut to_delete: Vec<EntityId> = Vec::new(); // live only (created after)  -> delete
        {
            let live = read_or_recover(&store.{{ s.entities[e].snake_name }}s);
            for id in &ids {
                match (snap.{{ s.entities[e].snake_name }}s.contains_key(id), live.contains_key(id)) {
                    (true, false) => to_create.push(*id),
                    (true, true) => to_update.push(*id),
                    (false, true) => to_delete.push(*id),
                    (false, false) => {}
                }
            }
        }

        // 1. Recurse into strong children first (collect child ids from snapshot + live, then drop
        //    all locks before recursing so self-referential ownership cannot deadlock).
{%- for f in s.entities[e].fields %}
{%- if f.inner.field_type == "Entity" and f.inner.strong %}
        {
            let mut child_ids: Vec<EntityId> = Vec::new();
            for id in to_create.iter().chain(to_update.iter()) {
                if let Some(list) = snap.jn_{{ s.entities[f.inner.entity].snake_name }}_from_{{ s.entities[e].snake_name }}_{{ f.snake_name }}.get(id) {
                    child_ids.extend(list.iter().copied());
                }
            }
            {
                let live_jn = read_or_recover(&store.jn_{{ s.entities[f.inner.entity].snake_name }}_from_{{ s.entities[e].snake_name }}_{{ f.snake_name }});
                for id in &ids {
                    if let Some(list) = live_jn.get(id) {
                        child_ids.extend(list.iter().copied());
                    }
                }
            }
            child_ids.sort();
            child_ids.dedup();
            if !child_ids.is_empty() {
                repository_factory::write::create_{{ s.entities[f.inner.entity].snake_name }}_repository(self.transaction)?
                    .restore_subtree(event_buffer, snap, &child_ids, visited)?;
            }
        }
{%- endif %}
{%- endfor %}

        // 2. Entity rows: revert/re-add from snapshot, delete the ones created after it.
        {
            let mut live = write_or_recover(&store.{{ s.entities[e].snake_name }}s);
            for id in to_create.iter().chain(to_update.iter()) {
                if let Some(row) = snap.{{ s.entities[e].snake_name }}s.get(id) {
                    live.insert(*id, row.clone());
                }
            }
            for id in &to_delete {
                live.remove(id);
            }
        }

        // 3. This entity's own forward junctions (strong + weak): restored wholesale because the
        //    junction key is in-scope (owned exclusively by this trunk).
{%- for rid, r in s.entities[e].forward_relationships %}
        {
            let mut live_jn = write_or_recover(&store.jn_{{ s.entities[r.inner.right_entity].snake_name }}_from_{{ s.entities[e].snake_name }}_{{ r.field_snake_name }});
            for id in to_create.iter().chain(to_update.iter()) {
                match snap.jn_{{ s.entities[r.inner.right_entity].snake_name }}_from_{{ s.entities[e].snake_name }}_{{ r.field_snake_name }}.get(id) {
                    Some(v) => { live_jn.insert(*id, v.clone()); }
                    None => { live_jn.remove(id); }
                }
            }
            for id in &to_delete {
                live_jn.remove(id);
            }
        }
{%- endfor %}

        // 4. External weak referrers of these ids: reconcile surgically (membership only).
{%- for rid, r in s.entities[e].backward_relationships %}
{%- if r.inner.strength == "Weak" %}
        self.reconcile_backref_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }}(event_buffer, snap, &ids)?;
{%- endif %}
{%- endfor %}

        // 5. Events: precise per-id (Created/Updated/Removed), not a whole-store storm.
        if !to_create.is_empty() {
            event_buffer.push(Event { origin: Origin::DirectAccess(DirectAccessEntity::{{ s.entities[e].pascal_name }}(EntityEvent::Created)), ids: to_create.clone(), data: None });
{%- if s.entities[e].forward_relationships %}
            event_buffer.push(Event { origin: Origin::DirectAccess(DirectAccessEntity::{{ s.entities[e].pascal_name }}(EntityEvent::Updated)), ids: to_create.clone(), data: None });
{%- endif %}
        }
        if !to_update.is_empty() {
            event_buffer.push(Event { origin: Origin::DirectAccess(DirectAccessEntity::{{ s.entities[e].pascal_name }}(EntityEvent::Updated)), ids: to_update.clone(), data: None });
        }
        if !to_delete.is_empty() {
            event_buffer.push(Event { origin: Origin::DirectAccess(DirectAccessEntity::{{ s.entities[e].pascal_name }}(EntityEvent::Removed)), ids: to_delete.clone(), data: None });
        }

        Ok(())
    }
{%- for rid, r in s.entities[e].backward_relationships %}

    /// Surgically reconcile one external referrer junction (out-of-scope key -> in-scope values):
    /// `{{ s.entities[r.inner.left_entity].snake_name }}.{{ r.field_snake_name }}`.
    fn reconcile_backref_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }}(
        &self,
        event_buffer: &mut EventBuffer,
        snap: &HashMapStoreSnapshot,
        scope_ids: &[EntityId],
    ) -> Result<(), RepositoryError> {
        let scope: std::collections::HashSet<EntityId> = scope_ids.iter().copied().collect();
        if scope.is_empty() {
            return Ok(());
        }
        let store = self.transaction.get_store();

        // External left keys whose ordered list references any scope id, in snapshot or live.
        let mut left_keys: std::collections::HashSet<EntityId> = std::collections::HashSet::new();
        for (left, rights) in snap.jn_{{ s.entities[e].snake_name }}_from_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }}.iter() {
            if rights.iter().any(|rid| scope.contains(rid)) {
                left_keys.insert(*left);
            }
        }
        {
            let live_jn = read_or_recover(&store.jn_{{ s.entities[e].snake_name }}_from_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }});
            for (left, rights) in live_jn.iter() {
                if rights.iter().any(|rid| scope.contains(rid)) {
                    left_keys.insert(*left);
                }
            }
        }

        for left in left_keys {
            let snap_list: Vec<EntityId> = snap.jn_{{ s.entities[e].snake_name }}_from_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }}.get(&left).cloned().unwrap_or_default();
            let new_list = {
                let live_jn = read_or_recover(&store.jn_{{ s.entities[e].snake_name }}_from_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }});
                let live_list: Vec<EntityId> = live_jn.get(&left).cloned().unwrap_or_default();
                let reconciled = crate::database::hashmap_store::reconcile_backref_list(&live_list, &snap_list, &scope);
                if reconciled == live_list { None } else { Some(reconciled) }
            };
            if let Some(reconciled) = new_list {
                write_or_recover(&store.jn_{{ s.entities[e].snake_name }}_from_{{ s.entities[r.inner.left_entity].snake_name }}_{{ r.field_snake_name }}).insert(left, reconciled);
                event_buffer.push(Event { origin: Origin::DirectAccess(DirectAccessEntity::{{ s.entities[r.inner.left_entity].pascal_name }}(EntityEvent::Updated)), ids: vec![left], data: None });
            }
        }
        Ok(())
    }
{%- endfor %}
}


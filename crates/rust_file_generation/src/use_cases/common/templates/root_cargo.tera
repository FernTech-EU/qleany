# Generated by Qleany v{{ s.system.inner.version }} from {{ s.file.inner.template_name }}.tera

[workspace]

members = [
    "{{ s.global.prefix }}/common",
    "{{ s.global.prefix }}/direct_access",
    "{{ s.global.prefix }}/macros",
{%- for fid, feature in s.features %}
    "{{ s.global.prefix }}/{{ feature.snake_name }}",
{%- endfor %}
    "{{ s.global.prefix }}/frontend",
{%- if s.ui.inner.rust_cli %}
    "{{ s.global.prefix }}/cli",
{%- endif %}
{%- if s.ui.inner.rust_teksilo %}
    "{{ s.global.prefix }}/teksilo_ui",
{%- endif %}
{%- if s.ui.inner.rust_slint %}
    "{{ s.global.prefix }}/slint_ui",
{%- endif %}
{%- if s.ui.inner.rust_ios or s.ui.inner.rust_android %}
    "{{ s.global.prefix }}/mobile_bridge",
{%- endif %}
    ]

{#- The one target `cargo run` / `cargo build` should pick, in precedence order:
    teksilo > slint > cli. `mobile_bridge` is a cdylib consumed by Swift/Kotlin and
    is never a default member; with no runnable frontend we emit no
    `default-members` at all, so the whole workspace builds. -#}
{%- set_global default_member = "" %}
{%- if s.ui.inner.rust_teksilo %}
{%- set_global default_member = "teksilo_ui" %}
{%- elif s.ui.inner.rust_slint %}
{%- set_global default_member = "slint_ui" %}
{%- elif s.ui.inner.rust_cli %}
{%- set_global default_member = "cli" %}
{%- endif %}
{%- if default_member %}

default-members = [
    "{{ s.global.prefix }}/{{ default_member }}",
]
{%- endif %}

resolver = "3"

[workspace.package]
authors = ["{{ s.global.inner.organisation_name }}"]
homepage = ""
repository = ""
documentation = "https://docs.rs/{{ s.global.application_kebab_name }}/"
description = "{{ s.global.inner.application_name }} - built with Qleany clean architecture."
keywords = ["to-be-filled"]
categories = ["to-be-filled"]
license = "MIT OR Apache-2.0"
readme = "README.md"
edition = "2024"
version = "0.0.1"

[workspace.dependencies]
thiserror = "2.0"
anyhow = "1.0"
flume = "0.12"
serde = { version = "1", features = ["derive"] }
chrono = { version = "0.4" , features = ["serde"] }
uuid = { version = "1", features = ["v4", "serde"] }

# Internal crates
common = { package = "{{ s.global.application_kebab_name }}-common", version = "0.0.1", path = "{{ s.global.prefix }}/common" }
macros = { package = "{{ s.global.application_kebab_name }}-macros", version = "0.0.1", path = "{{ s.global.prefix }}/macros" }
direct_access = { package = "{{ s.global.application_kebab_name }}-direct-access", version = "0.0.1", path = "{{ s.global.prefix }}/direct_access" }
frontend = { package = "{{ s.global.application_kebab_name }}-frontend", version = "0.0.1", path = "{{ s.global.prefix }}/frontend" }
{%- for fid, feature in s.features %}
{{ feature.snake_name }} = { package = "{{ s.global.application_kebab_name }}-{{ feature.snake_name | replace(from="_", to="-") }}", version = "0.0.1", path = "{{ s.global.prefix }}/{{ feature.snake_name }}" }
{%- endfor %}
{%- if s.ui.inner.rust_ios or s.ui.inner.rust_android %}
mobile_bridge = { package = "{{ s.global.application_kebab_name }}-mobile-bridge", version = "0.0.1", path = "{{ s.global.prefix }}/mobile_bridge" }
{%- endif %}

# Debuginfo, not compilation, dominates a Teksilo project's disk footprint.
# Measured on examples/rust/full: under Cargo's default `debug = 2` the demo
# binary was 685 MB, of which 557 MB -- 81% -- was debug sections, and
# tests/rust/target had reached 22 GB. That matters twice over: GitHub's Actions
# cache is capped at 10 GB per repository, so a tree this size cannot be cached
# at all, and a contributor's disk fills up.
#
# `line-tables-only` keeps exactly what a bug report needs -- `file:line` in
# panic messages and backtraces -- and drops only the variable and type
# information a *step-debugger* wants. To run one crate under gdb/lldb, override
# that crate rather than editing this line:
#
#     [profile.dev.package.teksilo_ui]
#     debug = 2
#
# `split-debuginfo = "unpacked"` then leaves the reduced DWARF in the object
# files beside the binary instead of copying it into the executable at link time.
[profile.dev]
debug = "line-tables-only"
split-debuginfo = "unpacked"

[profile.release]
lto = "fat"
panic = "abort"
strip = true
codegen-units = 1

[workspace.lints.rust]


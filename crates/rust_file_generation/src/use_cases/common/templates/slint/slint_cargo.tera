# Generated by Qleany v{{ s.system.inner.version }} from {{ s.file.inner.template_name }}.tera

[package]
name = "{{ s.global.application_snake_name }}"
description = "Desktop UI for {{ s.global.inner.application_name }}"
authors.workspace = true
documentation.workspace = true
keywords.workspace = true
categories.workspace = true
version.workspace = true
edition.workspace = true
homepage.workspace = true
repository.workspace = true
license.workspace = true
readme = "../../README.md"
publish = true
build = "build.rs"

# Named explicitly so it cannot collide with the Teksilo crate's binary. Cargo
# would otherwise derive this bin's name from the package name, which is the bare
# application name -- exactly what `teksilo_ui` calls its own binary. With both
# targets enabled that is an output-filename collision, and it only surfaces on
# `cargo build`: `cargo check` writes hash-named metadata and passes.
[[bin]]
name = "{{ s.global.application_snake_name }}-slint"
path = "src/main.rs"

[dependencies]
slint = "1.14"
log = "0.4"
env_logger = "0.11"

# Backend
frontend = { workspace = true }
anyhow = { workspace = true }
chrono = { workspace = true }

[build-dependencies]
slint-build = "1.14"

[lints]
workspace = true

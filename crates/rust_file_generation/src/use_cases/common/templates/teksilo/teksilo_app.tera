// Generated by Qleany v{{ s.system.inner.version }} from {{ s.file.inner.template_name }}.tera
{#- ── Demo-entity election ────────────────────────────────────────────────
     Pick the first relationship that is list_model, entity-typed, STRONG (so
     the holder owns the target and `create_{target}` exists), whose holder is
     the target's declared owner, and whose target has at least one editable
     scalar. Mirrors qt_widgets_main_window_cpp.tera, adapted to the Rust VMs:
     snake_name rather than camel_name, plus the ownership check Rust needs
     because `create_{e}` is only generated when the entity has an owner. -#}
{%- set_global demo_ent = false %}
{%- set_global list_ent = false %}
{%- set_global list_field = false %}
{%- for eid, ent in s.entities %}
  {%- if not demo_ent and not ent.inner.only_for_heritage %}
    {%- for f in ent.fields %}
      {%- if not demo_ent and f.inner.list_model and f.inner.entity and f.inner.strong %}
        {%- set target = s.entities[f.inner.entity] %}
        {%- set_global is_owner = false %}
        {%- if target.owner_snake_name == ent.snake_name %}{% set_global is_owner = true %}{% endif %}
        {%- set_global has_form_fields = false %}
        {%- for tf in target.normal_fields %}
          {%- if not tf.is_list and not tf.optional and tf.snake_name != "created_at" and tf.snake_name != "updated_at" %}
            {%- if tf.inner.field_type != "Enum" and tf.inner.field_type != "Entity" %}
              {%- set_global has_form_fields = true %}
            {%- endif %}
          {%- endif %}
        {%- endfor %}
        {%- if is_owner and has_form_fields and not target.inner.only_for_heritage %}
          {%- set_global list_ent = ent %}
          {%- set_global list_field = f %}
          {%- set_global demo_ent = target %}
        {%- endif %}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
{%- endfor %}

//! The demo main window.

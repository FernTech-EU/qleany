// Generated by Qleany v{{ s.system.inner.version }} from {{ s.file.inner.template_name }}.tera
{#- ── Demo-entity election ────────────────────────────────────────────────
     Pick the first relationship that is list_model, entity-typed, STRONG (so
     the holder owns the target and `create_{target}` exists), whose holder is
     the target's declared owner, and whose target has at least one editable
     scalar. Mirrors qt_widgets_main_window_cpp.tera, adapted to the Rust VMs:
     snake_name rather than camel_name, plus the ownership check Rust needs
     because `create_{e}` is only generated when the entity has an owner. -#}
{%- set_global demo_ent = false %}
{%- set_global list_ent = false %}
{%- set_global list_field = false %}
{%- for eid, ent in s.entities %}
  {%- if not demo_ent and not ent.inner.only_for_heritage %}
    {%- for f in ent.fields %}
      {%- if not demo_ent and f.inner.list_model and f.inner.entity and f.inner.strong %}
        {%- set target = s.entities[f.inner.entity] %}
        {%- set_global is_owner = false %}
        {%- if target.owner_snake_name == ent.snake_name %}{% set_global is_owner = true %}{% endif %}
        {%- set_global has_form_fields = false %}
        {%- for tf in target.normal_fields %}
          {%- if not tf.is_list and not tf.optional and tf.snake_name != "created_at" and tf.snake_name != "updated_at" %}
            {%- if tf.inner.field_type != "Enum" and tf.inner.field_type != "Entity" %}
              {%- set_global has_form_fields = true %}
            {%- endif %}
          {%- endif %}
        {%- endfor %}
        {%- if is_owner and has_form_fields and not target.inner.only_for_heritage %}
          {%- set_global list_ent = ent %}
          {%- set_global list_field = f %}
          {%- set_global demo_ent = target %}
        {%- endif %}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
{%- endfor %}

//! The demo main window.
//!
//! Regenerating overwrites this file -- it is a `Scaffold`, the starting point
//! you replace with your real UI.
{% if demo_ent %}
use teksilo::data::{SelectionMode, SelectionModel};
use teksilo::prelude::*;
use teksilo::widgets::{
    Button, ButtonVariant, Checkbox, ComboBox, Divider, Expand, FormLayout, HStack, ListView,
    Padding, Panel, Spacer, SpinBox, StandardListItem, TextInput, TextWidget, VStack,
};

use frontend::EntityId;
use frontend::direct_access::Create{{ demo_ent.pascal_name }}Dto;
{%- for f in demo_ent.normal_fields %}
{%- if f.inner.field_type == "Enum" and not f.is_list %}
use frontend::common::entities::{{ f.inner.enum_name }};
{%- endif %}
{%- endfor %}

use crate::models::{{ list_ent.pascal_name }}{{ list_field.pascal_name }}Row;
use crate::session::Session;

/// Two-way form state: one signal per editable scalar of `{{ demo_ent.pascal_name }}`.
#[derive(Clone)]
struct FormState {
    {%- for f in demo_ent.normal_fields %}
    {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
    {%- if f.inner.field_type == "Boolean" %}
    {{ f.snake_name }}: Signal<bool>,
    {%- elif f.inner.field_type == "Integer" %}
    {{ f.snake_name }}: Signal<i64>,
    {%- elif f.inner.field_type == "UInteger" %}
    {{ f.snake_name }}: Signal<u64>,
    {%- elif f.inner.field_type == "Float" %}
    {{ f.snake_name }}: Signal<f64>,
    {%- elif f.inner.field_type == "Enum" %}
    {{ f.snake_name }}: Signal<Option<String>>,
    {%- else %}
    {{ f.snake_name }}: Signal<String>,
    {%- endif %}
    {%- endif %}
    {%- endfor %}
}

impl FormState {
    fn new() -> Self {
        Self {
            {%- for f in demo_ent.normal_fields %}
            {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
            {{ f.snake_name }}: Signal::new(Default::default()),
            {%- endif %}
            {%- endfor %}
        }
    }

    /// Read the widgets back into a Create DTO.
    ///
    /// `..Default::default()` covers every field the form does not own --
    /// relationship ids, lists, optionals -- which is what lets this compile for
    /// an arbitrary entity. The timestamps are stamped by the list model's
    /// `create`, not here.
    fn to_create_dto(&self) -> Create{{ demo_ent.pascal_name }}Dto {
        Create{{ demo_ent.pascal_name }}Dto {
            {%- for f in demo_ent.normal_fields %}
            {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
            {%- if f.inner.field_type == "Boolean" or f.inner.field_type == "Integer" or f.inner.field_type == "UInteger" or f.inner.field_type == "Float" %}
            {{ f.snake_name }}: self.{{ f.snake_name }}.get(),
            {%- elif f.inner.field_type == "Enum" %}
            {{ f.snake_name }}: match self.{{ f.snake_name }}.get().as_deref() {
                {%- for pv in f.parsed_variants %}
                {%- if pv.is_simple %}
                Some("{{ pv.name }}") => {{ f.inner.enum_name }}::{{ pv.name }},
                {%- endif %}
                {%- endfor %}
                _ => Default::default(),
            },
            {%- elif f.inner.field_type == "Uuid" %}
            // An empty or unparseable field mints a fresh id rather than
            // failing the whole create.
            {{ f.snake_name }}: uuid::Uuid::parse_str(&self.{{ f.snake_name }}.get())
                .unwrap_or_else(|_| uuid::Uuid::new_v4()),
            {%- elif f.inner.field_type == "DateTime" %}
            {{ f.snake_name }}: chrono::DateTime::parse_from_rfc3339(&self.{{ f.snake_name }}.get())
                .map(|d| d.with_timezone(&chrono::Utc))
                .unwrap_or_else(|_| chrono::Utc::now()),
            {%- else %}
            {{ f.snake_name }}: self.{{ f.snake_name }}.get(),
            {%- endif %}
            {%- endif %}
            {%- endfor %}
            ..Default::default()
        }
    }

    fn clear(&self) {
        {%- for f in demo_ent.normal_fields %}
        {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
        self.{{ f.snake_name }}.set(Default::default());
        {%- endif %}
        {%- endfor %}
    }
}

pub struct AppRoot {
    session: Session,
    form: FormState,
    selection: SelectionModel,
    selected_id: Signal<Option<EntityId>>,
    root_child: Option<WidgetId>,
}

impl std::fmt::Debug for AppRoot {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("AppRoot").finish_non_exhaustive()
    }
}

impl AppRoot {
    pub fn new(session: Session) -> Self {
        Self {
            session,
            form: FormState::new(),
            selection: SelectionModel::new(SelectionMode::Single),
            selected_id: Signal::new(None),
            root_child: None,
        }
    }
}

impl Widget for AppRoot {
    fn build(&mut self, ctx: &mut BuildContext) -> Vec<WidgetId> {
        // Every subscription in the app, reinstalled on every build.
        self.session.wire_all(ctx);

        let stack_id = self.session.stack_id;
        let can_undo = self.session.undo_redo.can_undo();
        let can_redo = self.session.undo_redo.can_redo();

        let header = HStack::new()
            .spacing(12.0)
            .child(
                TextWidget::new(lit!("Teksilo + Qleany")).style(TextStyleRole::BodyBold),
            )
            .child(TextWidget::new(lit!("{{ s.global.inner.application_name }}")).color(TextRole::Secondary))
            .child(Spacer::new())
            .child({
                let undo_redo = self.session.undo_redo.clone();
                Button::new(lit!("Undo"))
                    .enabled(can_undo)
                    .on_activate_fn(move |_| undo_redo.undo())
            })
            .child({
                let undo_redo = self.session.undo_redo.clone();
                Button::new(lit!("Redo"))
                    .enabled(can_redo)
                    .on_activate_fn(move |_| undo_redo.redo())
            });

        // ── Column 1: the form ────────────────────────────────────────────
        let mut form = FormLayout::new().row_spacing(8.0);
        {%- for f in demo_ent.normal_fields %}
        {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
        {%- if f.inner.field_type == "Boolean" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            Checkbox::new(self.form.{{ f.snake_name }}.clone()).labels_hidden(true),
        );
        {%- elif f.inner.field_type == "Integer" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            SpinBox::new(self.form.{{ f.snake_name }}.clone(), i64::MIN / 2, i64::MAX / 2),
        );
        {%- elif f.inner.field_type == "UInteger" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            SpinBox::new(self.form.{{ f.snake_name }}.clone(), 0u64, u64::MAX / 2),
        );
        {%- elif f.inner.field_type == "Float" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            SpinBox::new(self.form.{{ f.snake_name }}.clone(), -1.0e15f64, 1.0e15f64),
        );
        {%- elif f.inner.field_type == "Enum" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            ComboBox::new(
                vec![{% for pv in f.parsed_variants %}{% if pv.is_simple %}"{{ pv.name }}", {% endif %}{% endfor %}],
                self.form.{{ f.snake_name }}.clone(),
            ),
        );
        {%- elif f.inner.field_type == "Uuid" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            TextInput::new(self.form.{{ f.snake_name }}.clone())
                .placeholder(lit!("Auto-generated UUID")),
        );
        {%- elif f.inner.field_type == "DateTime" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            TextInput::new(self.form.{{ f.snake_name }}.clone())
                .placeholder(lit!("YYYY-MM-DDTHH:MM:SSZ")),
        );
        {%- else %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            TextInput::new(self.form.{{ f.snake_name }}.clone())
                .placeholder(lit!("Enter {{ f.snake_name }}...")),
        );
        {%- endif %}
        {%- endif %}
        {%- endfor %}

        let add_button = {
            let model = self.session.{{ list_ent.snake_name }}_{{ list_field.snake_name }}.clone();
            let form_state = self.form.clone();
            Button::new(lit!("Add {{ demo_ent.pascal_name }}"))
                .variant(ButtonVariant::Filled)
                .on_activate_fn(move |_| {
                    // `-1` appends: the order is the user's, and a new row
                    // joining at the top would claim to be first.
                    if model
                        .create(&form_state.to_create_dto(), -1, stack_id)
                        .is_some()
                    {
                        form_state.clear();
                    }
                })
        };

        let form_column = VStack::new()
            .spacing(8.0)
            .child(TextWidget::new(lit!("New {{ demo_ent.pascal_name }}")).style(TextStyleRole::BodyBold))
            .child(Divider::horizontal())
            .child(form)
            .child(add_button)
            .child(Spacer::new());

        // ── Column 2: the list ────────────────────────────────────────────
        let list_model = self
            .session
            .{{ list_ent.snake_name }}_{{ list_field.snake_name }}
            .list_model();
        {
            // Selection -> detail, through an effect so it fires only on change:
            // writing during `build` would dirty this widget and rebuild forever.
            let selection = self.selection.selection_signal();
            let rows = list_model.clone();
            let selected_id = self.selected_id.clone();
            {%- if demo_ent.inner.single_model %}
            let single = self.session.single_{{ demo_ent.snake_name }}.clone();
            {%- endif %}
            ctx.effect(&selection, move |indices| {
                let id = indices
                    .iter()
                    .next()
                    .and_then(|i| rows.with_item(*i, |r| r.id));
                selected_id.set_if_changed(id);
                {%- if demo_ent.inner.single_model %}
                single.set_id(id);
                {%- endif %}
            });
        }

        let list_view = ListView::new(
            list_model,
            move |_index, row: &{{ list_ent.pascal_name }}{{ list_field.pascal_name }}Row, selected| {
                Box::new(
                    StandardListItem::new(lit!(row.display_text()))
                        .subtitle(lit!(format!("#{}", row.id)))
                        .selected(selected),
                )
            },
        )
        .item_height(44.0)
        .selection(self.selection.clone());

        let list_column = VStack::new()
            .spacing(8.0)
            .child(
                TextWidget::new(lit!(
                    "{{ demo_ent.pascal_name }} list (from {{ list_ent.pascal_name }}.{{ list_field.snake_name }})"
                ))
                .style(TextStyleRole::BodyBold),
            )
            .child(Divider::horizontal())
            .child(Expand::new().child(list_view));

        // ── Column 3: the detail ──────────────────────────────────────────
        {%- if demo_ent.inner.single_model %}
        let single = self.session.single_{{ demo_ent.snake_name }}.clone();
        let mut detail = VStack::new()
            .spacing(8.0)
            .child(TextWidget::new(lit!("{{ demo_ent.pascal_name }} Detail")).style(TextStyleRole::BodyBold))
            .child(Divider::horizontal());

        if self.selected_id.get().is_none() {
            detail = detail
                .child(TextWidget::new(lit!("Select an item in the list")).color(TextRole::Secondary));
        } else {
            let mut rows = FormLayout::new().row_spacing(6.0);
            {%- for f in demo_ent.normal_fields %}
            {%- if f.inner.field_type == "String" and not f.is_list and not f.optional %}
            rows = rows.line(
                TextWidget::new(lit!("{{ f.pascal_name }}")).style(TextStyleRole::BodyBold),
                TextWidget::new(lit!(single.{{ f.snake_name }}().get())),
            );
            {%- else %}
            // `{:?}` is the one formatting every generated type has: enums, Vec,
            // Option, Uuid and DateTime all derive Debug. The Rust analogue of
            // the C++ template's `QVariant::fromValue(..).toString()`.
            rows = rows.line(
                TextWidget::new(lit!("{{ f.pascal_name }}")).style(TextStyleRole::BodyBold),
                TextWidget::new(lit!(format!("{:?}", single.{{ f.snake_name }}().get()))),
            );
            {%- endif %}
            {%- endfor %}
            detail = detail.child(rows);
        }
        let detail_column = detail.child(Spacer::new());
        {%- else %}
        // First level of graceful degradation: the demo still builds, and says
        // what to turn on.
        let detail_column = VStack::new()
            .spacing(8.0)
            .child(TextWidget::new(lit!("{{ demo_ent.pascal_name }} Detail")).style(TextStyleRole::BodyBold))
            .child(Divider::horizontal())
            .child(
                TextWidget::new(lit!(
                    "To see the detail view, enable single_model on the \
                     {{ demo_ent.pascal_name }} entity in qleany.yaml:\n\n  \
                     - name: {{ demo_ent.pascal_name }}\n    single_model: true"
                ))
                .color(TextRole::Secondary),
            )
            .child(Spacer::new());
        {%- endif %}

        let content = HStack::new()
            .spacing(24.0)
            .child(form_column)
            .child(Expand::new().child(list_column))
            .child(Expand::new().child(detail_column));

        let footer = TextWidget::new(lit!("Generated by Qleany -- {{ s.global.inner.application_name }}"))
            .color(TextRole::Secondary);

        let root = ctx.add(
            Panel::new().child(
                Padding::uniform(16.0).child(
                    VStack::new()
                        .spacing(16.0)
                        .child(header)
                        .child(Divider::horizontal())
                        .child(Expand::new().child(content))
                        .child(Divider::horizontal())
                        .child(footer),
                ),
            ),
        );
        self.root_child = Some(root);
        vec![root]
    }

    fn layout_response(&self, proposal: SizeProposal, ctx: &LayoutContext) -> LayoutResponse {
        self.root_child
            .and_then(|id| ctx.child_size(id, proposal))
            .unwrap_or_else(|| proposal.resolve(0.0, 0.0))
            .into()
    }
}
{% else %}
// ── Second level of graceful degradation ────────────────────────────────
//
// No relationship in this manifest is list_model + entity-typed + strong with
// an owned target carrying editable scalars, so there is nothing to demo. The
// crate still compiles and the window still opens; it just says why.

use teksilo::prelude::*;
use teksilo::widgets::{Padding, Panel, TextWidget};

use crate::session::Session;

pub struct AppRoot {
    _session: Session,
    root_child: Option<WidgetId>,
}

impl std::fmt::Debug for AppRoot {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("AppRoot").finish_non_exhaustive()
    }
}

impl AppRoot {
    pub fn new(session: Session) -> Self {
        Self {
            _session: session,
            root_child: None,
        }
    }
}

impl Widget for AppRoot {
    fn build(&mut self, ctx: &mut BuildContext) -> Vec<WidgetId> {
        let root = ctx.add(
            Panel::new().child(
                Padding::uniform(32.0).child(TextWidget::new(lit!(
                    "To see the demo, add a relationship with list_model enabled whose target \
                     entity is owned by the holder (strong: true) and has editable fields. For \
                     example, add an ordered_one_to_many from Workspace to an entity like Car \
                     (with a 'brand' field), strong: true, list_model: true."
                ))),
            ),
        );
        self.root_child = Some(root);
        vec![root]
    }

    fn layout_response(&self, proposal: SizeProposal, ctx: &LayoutContext) -> LayoutResponse {
        self.root_child
            .and_then(|id| ctx.child_size(id, proposal))
            .unwrap_or_else(|| proposal.resolve(0.0, 0.0))
            .into()
    }
}
{% endif %}

    imports above: importing one item twice does not compile. -#}
{%- set_global has_bootstrap = false %}
{%- if demo_ent.ownership_chain | length > 0 %}{% set_global has_bootstrap = true %}{% endif %}
{%- set_global chain_root = false %}
{%- if has_bootstrap %}
{%- set_global chain_root = demo_ent.ownership_chain | first %}
use frontend::commands::undo_redo_commands;
{%- for a in demo_ent.ownership_chain %}
{%- if a.snake_name != demo_ent.snake_name and a.snake_name not in seen_child_targets %}
{%- set_global seen_child_targets = seen_child_targets | concat(with=a.snake_name) %}
use frontend::commands::{{ a.snake_name }}_commands;
use frontend::direct_access::Create{{ a.pascal_name }}Dto;
{%- endif %}
{%- endfor %}
{%- endif %}

use crate::models::{{ list_ent.pascal_name }}{{ list_field.pascal_name }}Row;
use crate::session::Session;

/// The entity this window elected to demo.
///
/// Published so the generated headless test (`tests/demo_headless.rs`) can
/// cross-check it against its own election. The election is template-level
/// computation and Tera cannot share a `set_global` across files, so the test
/// template runs its own copy; identical copies drift the moment one is edited,
/// and a drifted test would exercise a list this window never shows -- and pass.
pub const DEMO_ENTITY: &str = "{{ demo_ent.pascal_name }}";
{%- if has_bootstrap %}

/// Create the owner hierarchy the demo window needs, then point the lists at
/// it. Call once, from `run()`.
///
/// A free function here rather than a method on `Session`: this is demo
/// scaffolding, and `app.rs` is the `Scaffold` -- the one file you are meant to
/// throw away. It also keeps the demo-entity election in a single template. The
/// election picks the entity the form and the Add button drive; the hierarchy
/// below is that entity's ownership chain. Elect twice, in two templates, and
/// nothing stops an edit to one from seeding an owner the button never reads,
/// which is a silent no-op button that still compiles.
///
/// The store starts empty. Nothing in the generated UI creates an owner, so
/// without this walk every `*_owner` signal stays `None`, every list model
/// refuses to create under a missing owner, and the demo's
/// "Add {{ demo_ent.pascal_name }}" button is a silent no-op.
///
/// **Never from a widget's `build`**: `build` reruns on every rebuild, and a
/// bootstrap that reran would mint a fresh `{{ chain_root.pascal_name }}` tree
/// each time. The early return below is a second line of defence, not a
/// licence to move the call.
///
/// The walk is `demo_ent`'s ownership chain, root first:
/// {% for a in demo_ent.ownership_chain %}`{{ a.pascal_name }}`{% if not loop.last %} -> {% endif %}{% endfor %} -> `{{ demo_ent.pascal_name }}` (yours to add).
pub fn bootstrap(session: &Session) {
    // Scaffolding, not user work: a second call would mint a second
    // `{{ chain_root.pascal_name }}` and orphan everything already on screen.
    if session.{{ list_ent.snake_name }}_{{ list_field.snake_name }}_owner.get().is_some() {
        log::debug!("bootstrap: already done, skipping");
        return;
    }

    let now = chrono::Utc::now();
    {%- set_global prev_snake = "" %}
    {%- set_global prev_pascal = "" %}
    {%- for a in demo_ent.ownership_chain %}

    {%- if loop.first %}
    let {{ a.snake_name }}_id = match {{ a.snake_name }}_commands::create_orphan_{{ a.snake_name }}(
        &session.app_ctx,
        {%- if a.undoable %}
        session.stack_id,
        {%- endif %}
        // `..Default::default()` covers whatever else this entity carries;
        // the two timestamps are mandatory on every entity and are the one
        // pair a `Default` would leave at the epoch.
        &Create{{ a.pascal_name }}Dto {
            created_at: now,
            updated_at: now,
            ..Default::default()
        },
    ) {
        Ok(dto) => dto.id,
        Err(e) => {
            log::error!("bootstrap: could not create the top-level {{ a.pascal_name }}: {e}");
            return;
        }
    };
    {%- else %}
    let {{ a.snake_name }}_id = match {{ a.snake_name }}_commands::create_{{ a.snake_name }}(
        &session.app_ctx,
        {%- if a.undoable %}
        session.stack_id,
        {%- endif %}
        &Create{{ a.pascal_name }}Dto {
            created_at: now,
            updated_at: now,
            ..Default::default()
        },
        {{ prev_snake }}_id,
        0,
    ) {
        Ok(dto) => dto.id,
        Err(e) => {
            log::error!(
                "bootstrap: could not create a {{ a.pascal_name }} under {{ prev_pascal }} \
                 #{% raw %}{{% endraw %}{{ prev_snake }}_id}: {e}"
            );
            return;
        }
    };
    {%- endif %}
    log::info!("bootstrap: created {{ a.pascal_name }} #{% raw %}{{% endraw %}{{ a.snake_name }}_id}");
    {%- set_global prev_snake = a.snake_name %}
    {%- set_global prev_pascal = a.pascal_name %}
    {%- endfor %}

    // Point every list whose owner the walk just created at that owner. A
    // list owned by something the walk does NOT create stays `None` on
    // purpose -- it is waiting for a selection, not broken.
    {%- for eid, ent in s.entities %}
    {%- if not ent.inner.only_for_heritage %}
    {%- for f in ent.fields %}
    {%- if f.inner.list_model and f.inner.entity %}
    {%- set_global owner_in_chain = false %}
    {%- for a in demo_ent.ownership_chain %}
    {%- if a.snake_name == ent.snake_name %}{% set_global owner_in_chain = true %}{% endif %}
    {%- endfor %}
    {%- if owner_in_chain %}
    session.{{ ent.snake_name }}_{{ f.snake_name }}_owner.set(Some({{ ent.snake_name }}_id));
    {%- else %}
    // `{{ ent.snake_name }}_{{ f.snake_name }}` hangs off a `{{ ent.pascal_name }}`, which this walk
    // does not create: seed it when one is selected or created.
    {%- endif %}
    {%- endif %}
    {%- endfor %}
    {%- endif %}
    {%- endfor %}

    // The hierarchy above is scenery, not something the user did. Leaving it
    // on the stack would open the app with Undo enabled and one click away
    // from deleting the {{ list_ent.pascal_name }} the list hangs off.
    // `UndoRedoBinder::wire` re-reads the manager on the first build, so this
    // is visible before anything is drawn.
    undo_redo_commands::clear_all_stacks(&session.app_ctx);
}
{%- else %}

/// Nothing to bootstrap.
///
/// `{{ demo_ent.pascal_name }}` has no owner above it, so there is no hierarchy
/// to build and no list-model owner to seed. Kept as a no-op so `run()` reads
/// the same for every manifest.
pub fn bootstrap(_session: &Session) {}
{%- endif %}

/// Two-way form state: one signal per editable scalar of `{{ demo_ent.pascal_name }}`.
///
/// `pub`, with `pub` fields, so the generated headless test
/// (`tests/demo_headless.rs`) can fill the form and call [`FormState::to_create_dto`]
/// rather than reimplement it. A copy of this conversion in the test would keep
/// passing while the real one regressed -- which is exactly how a required
/// reference left at id 0 reached a user's second click.
#[derive(Clone)]
pub struct FormState {
    {%- for f in demo_ent.normal_fields %}
    {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
    {%- if f.inner.field_type == "Boolean" %}
    pub {{ f.snake_name }}: Signal<bool>,
    {%- elif f.inner.field_type == "Integer" %}
    pub {{ f.snake_name }}: Signal<i64>,
    {%- elif f.inner.field_type == "UInteger" %}
    pub {{ f.snake_name }}: Signal<u64>,
    {%- elif f.inner.field_type == "Float" %}
    pub {{ f.snake_name }}: Signal<f64>,
    {%- elif f.inner.field_type == "Enum" %}
    pub {{ f.snake_name }}: Signal<Option<String>>,
    {%- else %}
    pub {{ f.snake_name }}: Signal<String>,
    {%- endif %}
    {%- endif %}
    {%- endfor %}
}

/// `new()` is public so the generated headless test can drive the window's own
/// form rather than a copy of it, and a public argument-less `new` without a
/// `Default` is `clippy::new_without_default`.
impl Default for FormState {
    fn default() -> Self {
        Self::new()
    }
}

impl FormState {
    pub fn new() -> Self {
        Self {
            {%- for f in demo_ent.normal_fields %}
            {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
            {{ f.snake_name }}: Signal::new(Default::default()),
            {%- endif %}
            {%- endfor %}
        }
    }

    /// Read the widgets back into a Create DTO.
    ///
    /// `..Default::default()` covers every field the form does not own --
    /// relationship ids, lists, optionals -- which is what lets this compile for
    /// an arbitrary entity. The timestamps are stamped by the list model's
    /// `create`, not here.
{%- if required_children | length > 0 %}
    ///
    /// Required entity references are the exception: `Default` leaves them at
    /// id 0, which is not a real row, so each one is minted first. `None` means
    /// a child could not be created and there is nothing valid to submit.
{%- endif %}
    pub fn to_create_dto(
        &self,
{%- if required_children | length > 0 %}
        app_ctx: &Rc<AppContext>,
        stack_id: Option<u64>,
{%- endif %}
    ) -> Option<Create{{ demo_ent.pascal_name }}Dto> {
{%- if required_children | length > 0 %}
        let now = chrono::Utc::now();
{%- endif %}
{%- for f in demo_ent.fields %}
{%- if f.inner.field_type == "Entity" and not f.is_list and not f.optional and f.inner.entity %}
{%- set target = s.entities[f.inner.entity] %}
        // `{{ f.snake_name }}` is a required reference to a {{ target.pascal_name }}.
        // Leaving it at `Default` (id 0) lets the first create claim a row that
        // does not exist, and every later one fails the one-to-one constraint.
        let {{ f.snake_name }} = match {{ target.snake_name }}_commands::create_orphan_{{ target.snake_name }}(
            app_ctx,
{%- if target.inner.undoable %}
            stack_id,
{%- endif %}
            &Create{{ target.pascal_name }}Dto {
                created_at: now,
                updated_at: now,
                ..Default::default()
            },
        ) {
            Ok(dto) => dto.id,
            Err(e) => {
                log::error!(
                    "Add {{ demo_ent.pascal_name }}: could not create the required \
                     {{ target.pascal_name }}: {e:#}"
                );
                return None;
            }
        };
{%- endif %}
{%- endfor %}
        Some(Create{{ demo_ent.pascal_name }}Dto {
            {%- for f in demo_ent.normal_fields %}
            {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
            {%- if f.inner.field_type == "Boolean" or f.inner.field_type == "Integer" or f.inner.field_type == "UInteger" or f.inner.field_type == "Float" %}
            {{ f.snake_name }}: self.{{ f.snake_name }}.get(),
            {%- elif f.inner.field_type == "Enum" %}
            {{ f.snake_name }}: match self.{{ f.snake_name }}.get().as_deref() {
                {%- for pv in f.parsed_variants %}
                {%- if pv.is_simple %}
                Some("{{ pv.name }}") => {{ f.inner.enum_name }}::{{ pv.name }},
                {%- endif %}
                {%- endfor %}
                _ => Default::default(),
            },
            {%- elif f.inner.field_type == "Uuid" %}
            // An empty or unparsable field mints a fresh id rather than
            // failing the whole create.
            {{ f.snake_name }}: uuid::Uuid::parse_str(&self.{{ f.snake_name }}.get())
                .unwrap_or_else(|_| uuid::Uuid::new_v4()),
            {%- elif f.inner.field_type == "DateTime" %}
            {{ f.snake_name }}: chrono::DateTime::parse_from_rfc3339(&self.{{ f.snake_name }}.get())
                .map(|d| d.with_timezone(&chrono::Utc))
                .unwrap_or_else(|_| chrono::Utc::now()),
            {%- else %}
            {{ f.snake_name }}: self.{{ f.snake_name }}.get(),
            {%- endif %}
            {%- endif %}
            {%- endfor %}
{%- for f in demo_ent.fields %}
{%- if f.inner.field_type == "Entity" and not f.is_list and not f.optional and f.inner.entity %}
            {{ f.snake_name }},
{%- endif %}
{%- endfor %}
            ..Default::default()
        })
    }

    fn clear(&self) {
        {%- for f in demo_ent.normal_fields %}
        {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
        self.{{ f.snake_name }}.set(Default::default());
        {%- endif %}
        {%- endfor %}
    }
}

pub struct AppRoot {
    session: Session,
    form: FormState,
    selection: SelectionModel,
    selected_id: Signal<Option<EntityId>>,
    root_child: Option<WidgetId>,
}

impl std::fmt::Debug for AppRoot {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("AppRoot").finish_non_exhaustive()
    }
}

impl AppRoot {
    pub fn new(session: Session) -> Self {
        Self {
            session,
            form: FormState::new(),
            selection: SelectionModel::new(SelectionMode::Single),
            selected_id: Signal::new(None),
            root_child: None,
        }
    }
}

impl Widget for AppRoot {
    fn build(&mut self, ctx: &mut BuildContext) -> Vec<WidgetId> {
        // Every subscription in the app, reinstalled on every build.
        self.session.wire_all(ctx);

        let stack_id = self.session.stack_id;
        let can_undo = self.session.undo_redo.can_undo();
        let can_redo = self.session.undo_redo.can_redo();

        let header = HStack::new()
            .spacing(12.0)
            .child(
                TextWidget::new(lit!("Teksilo + Qleany")).style(TextStyleRole::BodyBold),
            )
            .child(TextWidget::new(lit!("{{ s.global.inner.application_name }}")).color(TextRole::Secondary))
            .child(Spacer::new())
            .child({
                let undo_redo = self.session.undo_redo.clone();
                Button::new(lit!("Undo"))
                    .enabled(can_undo)
                    .on_activate_fn(move |_| undo_redo.undo())
            })
            .child({
                let undo_redo = self.session.undo_redo.clone();
                Button::new(lit!("Redo"))
                    .enabled(can_redo)
                    .on_activate_fn(move |_| undo_redo.redo())
            });

        // ── Column 1: the form ────────────────────────────────────────────
        let mut form = FormLayout::new().row_spacing(8.0);
        {%- for f in demo_ent.normal_fields %}
        {%- if not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Entity" %}
        {%- if f.inner.field_type == "Boolean" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            Checkbox::new(self.form.{{ f.snake_name }}.clone()).labels_hidden(true),
        );
        {%- elif f.inner.field_type == "Integer" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            SpinBox::new(self.form.{{ f.snake_name }}.clone(), i64::MIN / 2, i64::MAX / 2),
        );
        {%- elif f.inner.field_type == "UInteger" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            SpinBox::new(self.form.{{ f.snake_name }}.clone(), 0u64, u64::MAX / 2),
        );
        {%- elif f.inner.field_type == "Float" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            SpinBox::new(self.form.{{ f.snake_name }}.clone(), -1.0e15f64, 1.0e15f64),
        );
        {%- elif f.inner.field_type == "Enum" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            ComboBox::new(
                vec![{% for pv in f.parsed_variants %}{% if pv.is_simple %}"{{ pv.name }}", {% endif %}{% endfor %}],
                self.form.{{ f.snake_name }}.clone(),
            ),
        );
        {%- elif f.inner.field_type == "Uuid" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            TextInput::new(self.form.{{ f.snake_name }}.clone())
                .placeholder(lit!("Auto-generated UUID")),
        );
        {%- elif f.inner.field_type == "DateTime" %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            // `to_create_dto` already falls back to `chrono::Utc::now()` for an
            // empty or unparsable value, so the field is genuinely optional --
            // the old RFC 3339 example read as a required format.
            TextInput::new(self.form.{{ f.snake_name }}.clone())
                .placeholder(lit!("Auto-generated timestamp (optional)")),
        );
        {%- else %}
        form = form.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")),
            TextInput::new(self.form.{{ f.snake_name }}.clone())
                .placeholder(lit!("Enter {{ f.snake_name }}...")),
        );
        {%- endif %}
        {%- endif %}
        {%- endfor %}

        let add_button = {
            let model = self.session.{{ list_ent.snake_name }}_{{ list_field.snake_name }}.clone();
            let form_state = self.form.clone();
{%- if required_children | length > 0 %}
            let app_ctx = self.session.app_ctx.clone();
{%- endif %}
            Button::new(lit!("Add {{ demo_ent.pascal_name }}"))
                .variant(ButtonVariant::Filled)
                .on_activate_fn(move |_| {
{%- if required_children | length > 0 %}
                    // Minting the required children can fail; it logs its own
                    // reason, so there is nothing to add here.
                    let Some(dto) = form_state.to_create_dto(&app_ctx, stack_id) else {
                        return;
                    };
{%- else %}
                    let Some(dto) = form_state.to_create_dto() else {
                        return;
                    };
{%- endif %}
                    // `-1` appends: the order is the user's, and a new row
                    // joining at the top would claim to be first.
                    match model.create(&dto, -1, stack_id) {
                        Some(_) => form_state.clear(),
                        // Keep the form filled -- the user's typing is the only
                        // copy of it -- but never fail silently. The model logs
                        // a backend error itself; the case it cannot see is an
                        // unset owner, which means `bootstrap` did not run or
                        // gave up.
                        None => log::error!(
                            "Add {{ demo_ent.pascal_name }}: nothing was created. Either the \
                             backend refused it (logged just above) or \
                             `{{ list_ent.snake_name }}_{{ list_field.snake_name }}_owner` is \
                             still None, which means the {{ list_ent.pascal_name }} bootstrap \
                             did not run."
                        ),
                    }
                })
        };

        let form_column = VStack::new()
            .spacing(8.0)
            .child(TextWidget::new(lit!("New {{ demo_ent.pascal_name }}")).style(TextStyleRole::BodyBold))
            .child(Divider::horizontal())
            .child(form)
            .child(add_button)
            .child(Spacer::new());

        // ── Column 2: the list ────────────────────────────────────────────
        let list_model = self
            .session
            .{{ list_ent.snake_name }}_{{ list_field.snake_name }}
            .list_model();
        {
            // Selection -> detail, through an effect so it fires only on change:
            // writing during `build` would dirty this widget and rebuild forever.
            let selection = self.selection.selection_signal();
            let rows = list_model.clone();
            let selected_id = self.selected_id.clone();
            {%- if demo_ent.inner.single_model %}
            let single = self.session.single_{{ demo_ent.snake_name }}.clone();
            {%- endif %}
            ctx.effect(&selection, move |indices| {
                let id = indices
                    .iter()
                    .next()
                    .and_then(|i| rows.with_item(*i, |r| r.id));
                selected_id.set_if_changed(id);
                {%- if demo_ent.inner.single_model %}
                single.set_id(id);
                {%- endif %}
            });
        }

        let list_view = ListView::new(
            list_model,
            move |_index, row: &{{ list_ent.pascal_name }}{{ list_field.pascal_name }}Row, selected| {
                Box::new(
                    StandardListItem::new(lit!(row.display_text()))
                        .subtitle(lit!(format!("#{}", row.id)))
                        .selected(selected),
                )
            },
        )
        .item_height(44.0)
        .selection(self.selection.clone());

        let list_column = VStack::new()
            .spacing(8.0)
            .child(
                TextWidget::new(lit!(
                    "{{ demo_ent.pascal_name }} list (from {{ list_ent.pascal_name }}.{{ list_field.snake_name }})"
                ))
                .style(TextStyleRole::BodyBold),
            )
            .child(Divider::horizontal())
            .child(Expand::new().child(list_view));

        // ── Column 3: the detail ──────────────────────────────────────────
        {%- if demo_ent.inner.single_model %}
        let single = self.session.single_{{ demo_ent.snake_name }}.clone();
        // Every value below is *bound* to one of the single's signals. None of
        // them is read with `.get()` here, and that is the whole point: Teksilo
        // does not track signal reads made during `build`. A `.get()` in this
        // function yields a value frozen at build time -- `ctx.effect` only
        // installs an observer, it never marks the widget dirty, and there is no
        // `request_rebuild` -- so the detail column would show the first
        // selection for ever. Widgets update through bindings instead:
        // `TextWidget::text` takes a `Prop<String>`, a `Signal<String>` converts
        // into one, and the widget registers it with the binding registry so a
        // change relayouts and repaints the label on its own.
        // `TextWidget::new` takes a constant `LocalizedString`, so the live value
        // arrives through `.text(..)`, which replaces it. Each row is zipped with
        // the selection so it reads blank when nothing is selected: `clear()`
        // resets the single to `Default`, and the Debug of a default is not
        // nothing -- it is `1970-01-01T00:00:00Z`, `0`, `[]` and the first enum
        // variant, which would look like a real row that happens to be empty.
        // Non-String fields go through `{:?}`, the one formatting every generated
        // type has: enums, Vec, Option, Uuid and DateTime all derive Debug. It
        // runs inside the map, not here, so the row stays live instead of
        // capturing one formatted string.
        let mut rows = FormLayout::new().row_spacing(6.0);
        {%- for f in demo_ent.normal_fields %}
        rows = rows.line(
            TextWidget::new(lit!("{{ f.pascal_name }}")).style(TextStyleRole::BodyBold),
            TextWidget::new(lit!("")).text(self.selected_id.zip(&single.{{ f.snake_name }}()).map(
                |(selected, value)| match selected {
                    None => String::new(),
                    {%- if f.inner.field_type == "String" and not f.is_list and not f.optional %}
                    Some(_) => value.clone(),
                    {%- else %}
                    Some(_) => format!("{value:?}"),
                    {%- endif %}
                },
            )),
        );
        {%- endfor %}

        // The "nothing selected" state is a bound status line rather than an
        // `if` choosing between two children. Picking a child during `build` has
        // exactly the defect the rows above avoid: the choice is made once and
        // no later selection can revisit it.
        let detail_column = VStack::new()
            .spacing(8.0)
            .child(TextWidget::new(lit!("{{ demo_ent.pascal_name }} Detail")).style(TextStyleRole::BodyBold))
            .child(Divider::horizontal())
            .child(
                TextWidget::new(lit!(""))
                    .text(self.selected_id.map(|o| match o {
                        None => "Select an item in the list".to_string(),
                        Some(id) => format!("Selected #{id}"),
                    }))
                    .color(TextRole::Secondary),
            )
            .child(rows)
            .child(Spacer::new());
        {%- else %}
        // First level of graceful degradation: the demo still builds, and says
        // what to turn on.
        let detail_column = VStack::new()
            .spacing(8.0)
            .child(TextWidget::new(lit!("{{ demo_ent.pascal_name }} Detail")).style(TextStyleRole::BodyBold))
            .child(Divider::horizontal())
            .child(
                TextWidget::new(lit!(
                    "To see the detail view, enable single_model on the \
                     {{ demo_ent.pascal_name }} entity in qleany.yaml:\n\n  \
                     - name: {{ demo_ent.pascal_name }}\n    single_model: true"
                ))
                .color(TextRole::Secondary),
            )
            .child(Spacer::new());
        {%- endif %}

        let content = HStack::new()
            .spacing(24.0)
            .child(form_column)
            .child(Expand::new().child(list_column))
            .child(Expand::new().child(detail_column));

        let footer = TextWidget::new(lit!("Generated by Qleany -- {{ s.global.inner.application_name }}"))
            .color(TextRole::Secondary);

        let root = ctx.add(
            Panel::new().child(
                Padding::uniform(16.0).child(
                    VStack::new()
                        .spacing(16.0)
                        .child(header)
                        .child(Divider::horizontal())
                        .child(Expand::new().child(content))
                        .child(Divider::horizontal())
                        .child(footer),
                ),
            ),
        );
        self.root_child = Some(root);
        vec![root]
    }

    fn layout_response(&self, proposal: SizeProposal, ctx: &LayoutContext) -> LayoutResponse {
        self.root_child
            .and_then(|id| ctx.child_size(id, proposal))
            .unwrap_or_else(|| proposal.resolve(0.0, 0.0))
            .into()
    }
}
{% else %}
// ── Second level of graceful degradation ────────────────────────────────
//
// No relationship in this manifest is list_model + entity-typed + strong with
// an owned target carrying editable scalars, so there is nothing to demo. The
// crate still compiles and the window still opens; it just says why.

use teksilo::prelude::*;
use teksilo::widgets::{Padding, Panel, TextWidget};

use crate::session::Session;

/// No entity was elected, so there is nothing to demo.
///
/// Published for the same reason as its non-empty twin: the generated headless
/// test elects independently, and comparing the two names turns a silent
/// divergence into a failing test.
pub const DEMO_ENTITY: &str = "";

/// Nothing to bootstrap.
///
/// No relationship in this manifest elects a demo entity, so there is no owner
/// hierarchy to build and no list-model owner to seed. Kept as a no-op so
/// `run()` reads the same for every manifest.
pub fn bootstrap(_session: &Session) {}

pub struct AppRoot {
    _session: Session,
    root_child: Option<WidgetId>,
}

impl std::fmt::Debug for AppRoot {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("AppRoot").finish_non_exhaustive()
    }
}

impl AppRoot {
    pub fn new(session: Session) -> Self {
        Self {
            _session: session,
            root_child: None,
        }
    }
}

impl Widget for AppRoot {
    fn build(&mut self, ctx: &mut BuildContext) -> Vec<WidgetId> {
        let root = ctx.add(
            Panel::new().child(
                Padding::uniform(32.0).child(TextWidget::new(lit!(
                    "To see the demo, add a relationship with list_model enabled whose target \
                     entity is owned by the holder (strong: true) and has editable fields. For \
                     example, add an ordered_one_to_many from Workspace to an entity like Car \
                     (with a 'brand' field), strong: true, list_model: true."
                ))),
            ),
        );
        self.root_child = Some(root);
        vec![root]
    }

    fn layout_response(&self, proposal: SizeProposal, ctx: &LayoutContext) -> LayoutResponse {
        self.root_child
            .and_then(|id| ctx.child_size(id, proposal))
            .unwrap_or_else(|| proposal.resolve(0.0, 0.0))
            .into()
    }
}
{% endif %}

    Button, ButtonVariant, Checkbox, ComboBox, Divider, Expand, FormLayout, HStack, ListView,
    Padding, Panel, Spacer, SpinBox, StandardListItem, TextInput, TextWidget, VStack,
};

use frontend::EntityId;
use frontend::direct_access::Create{{ demo_ent.pascal_name }}Dto;
{#- A required, non-list entity reference cannot be left to `Default`: that is
    id 0, which is not a real row. The first create claims it and every later one
    trips the one-to-one constraint, so the demo's Add button works exactly once.
    Mint the child instead, which needs the command module for each target. -#}
{%- set_global required_children = [] %}
{%- set_global seen_child_targets = [] %}
{%- for f in demo_ent.fields %}
{%- if f.inner.field_type == "Entity" and not f.is_list and not f.optional and f.inner.entity %}
{%- set_global required_children = required_children | concat(with=f.snake_name) %}
{%- set target = s.entities[f.inner.entity] %}
{%- if target.snake_name not in seen_child_targets %}
{%- set_global seen_child_targets = seen_child_targets | concat(with=target.snake_name) %}
use frontend::commands::{{ target.snake_name }}_commands;
use frontend::direct_access::Create{{ target.pascal_name }}Dto;
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if required_children | length > 0 %}
use std::rc::Rc;

use frontend::AppContext;
{%- endif %}
{%- for f in demo_ent.normal_fields %}
{%- if f.inner.field_type == "Enum" and not f.is_list %}
use frontend::common::entities::{{ f.inner.enum_name }};
{%- endif %}
{%- endfor %}
{#- `bootstrap` below walks `demo_ent`'s ownership chain, so it needs the command
    module and the Create DTO of every ancestor, plus the undo/redo commands that

# Generated by Qleany v{{ s.system.inner.version }} from {{ s.file.inner.template_name }}.tera

[package]
name = "{{ s.global.application_kebab_name }}-teksilo-ui"
description = "Teksilo desktop UI for {{ s.global.inner.application_name }}"
authors.workspace = true
documentation.workspace = true
keywords.workspace = true
categories.workspace = true
version.workspace = true
edition.workspace = true
homepage.workspace = true
repository.workspace = true
license.workspace = true
readme = "../../README.md"
publish = false

# The library IS the application; the binary below is a one-line `fn main` that
# calls `run()`. A `[[bin]]`-only crate cannot be depended on, which would put
# every type here out of reach of the rest of the workspace, tests included.
[lib]
name = "teksilo_ui"
path = "src/lib.rs"

[[bin]]
name = "{{ s.global.application_snake_name }}"
path = "src/main.rs"

[features]
# Render the UI with fabricated data and no backend. Every single and every list
# model carries a `#[cfg(feature = "mocks")] mod imp` twin with an identical
# public surface, so no `#[cfg]` leaks into consuming code. Building both arms is
# not enough: this one is real alternate logic and clippy only lints the `#[cfg]`
# arm it compiled, so build, test AND clippy it in CI. See the mocks section of
# the Teksilo docs for the three commands.
mocks = []

[dependencies]
# A literal version, deliberately not `{ workspace = true }`: this crate is also
# compiled from test harnesses whose workspace root does not declare teksilo.
teksilo = "0.10.0"

# Backend
frontend = { workspace = true }
anyhow = { workspace = true }
chrono = { workspace = true }
uuid = { workspace = true }

log = "0.4"
env_logger = "0.11"

[lints]
workspace = true

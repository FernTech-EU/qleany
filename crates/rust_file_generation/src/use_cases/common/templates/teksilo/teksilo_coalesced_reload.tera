//! One reload per frame, however many events arrive.
//!
//! A batched write publishes one event per row -- `create_*_multi` over 200 rows
//! publishes 200 `Created` events, flushed together when the transaction
//! commits. A model that reloaded on each one would re-read the whole
//! relationship 200 times in a single burst.
//!
//! `wake_at` and not `frame_tick` alone: Teksilo only pumps a frame when
//! something asks for one, so an effect hung on `frame_tick` would fire when a
//! frame happened to be pumped for an unrelated reason -- which, for a
//! background import into a window nobody is touching, could be never.

use std::cell::Cell;
use std::rc::Rc;

use teksilo::prelude::*;

use frontend::common::event::{Event, Origin};

#[derive(Clone, Default)]
pub struct ReloadCoalescer {
    stale: Rc<Cell<bool>>,
}

impl ReloadCoalescer {
    pub fn new() -> Self {
        Self::default()
    }

    fn mark(&self, wake: &Rc<Cell<Option<std::time::Instant>>>) {
        self.stale.set(true);
        // Now, not "soon": this coalesces a burst, it does not debounce.
        wake.set(Some(std::time::Instant::now()));
    }

    fn take(&self) -> bool {
        self.stale.replace(false)
    }
}

/// Subscribe `on_reload` to every origin, collapsing a burst into one call.
///
/// Call this from a widget's `build`, on every build: a `BuildContext`
/// subscription is scoped to the current build and dropped on the next.
pub fn reload_on_events(
    ctx: &mut BuildContext,
    origins: impl IntoIterator<Item = Origin>,
    on_reload: impl Fn() + 'static,
) -> ReloadCoalescer {
    let coalescer = ReloadCoalescer::new();
    let wake = ctx.wake_at_handle();

    for origin in origins {
        let coalescer = coalescer.clone();
        let wake = wake.clone();
        ctx.subscribe_event(origin, move |_event: &Event| coalescer.mark(&wake));
    }

    let tick = ctx.frame_tick();
    {
        let coalescer = coalescer.clone();
        ctx.effect(&tick, move |_| {
            if coalescer.take() {
                on_reload();
            }
        });
    }

    coalescer
}

#[cfg(feature = "mocks")]
mod imp {
    use std::cell::RefCell;
    use std::rc::Rc;

    use teksilo::data::ListModel;
    use teksilo::prelude::*;

    use frontend::AppContext;
    use frontend::EntityId;
    use frontend::direct_access::Create{{ target.pascal_name }}Dto;

    use super::{{ ent.pascal_name }}{{ lf.pascal_name }}Row;

    /// Deterministic ids, never random: a fresh id per call would make the same
    /// row change identity between refreshes.
    fn mock_rows() -> Vec<{{ ent.pascal_name }}{{ lf.pascal_name }}Row> {
        (1..=5u64)
            .map(|id| {{ ent.pascal_name }}{{ lf.pascal_name }}Row {
                id,
                {%- for f in target.normal_fields %}
                {%- if f.inner.field_type == "String" and not f.is_list and not f.optional %}
                {{ f.snake_name }}: format!("Mock {{ target.pascal_name }} {id}"),
                {%- endif %}
                {%- endfor %}
                ..Default::default()
            })
            .collect()
    }

    /// Mutable, unlike most fabricated fixtures: a page whose whole content is
    /// the list it edits is untestable by eye against a fixture that refuses
    /// every edit. Writes land in the model and bump `version`, so the view
    /// reacts as it does against the real store -- it simply forgets on restart.
    #[derive(Clone)]
    pub struct {{ ent.pascal_name }}{{ lf.pascal_name }}ListModel {
        model: ListModel<{{ ent.pascal_name }}{{ lf.pascal_name }}Row>,
        version: Signal<u64>,
        owner_id: Signal<Option<EntityId>>,
        next_id: Rc<RefCell<EntityId>>,
    }

    #[allow(dead_code)] // identical surface to the real arm; some unused here
    impl {{ ent.pascal_name }}{{ lf.pascal_name }}ListModel {
        pub fn new(_ctx: Rc<AppContext>, owner_id: Signal<Option<EntityId>>) -> Self {
            Self {
                model: ListModel::from_vec(mock_rows()),
                version: Signal::new(0),
                owner_id,
                next_id: Rc::new(RefCell::new(100)),
            }
        }

        pub fn list_model(&self) -> ListModel<{{ ent.pascal_name }}{{ lf.pascal_name }}Row> {
            self.model.clone()
        }

        pub fn version_signal(&self) -> Signal<u64> {
            self.version.clone()
        }

        pub fn owner_id_signal(&self) -> Signal<Option<EntityId>> {
            self.owner_id.clone()
        }

        pub fn set_owner_id(&self, id: Option<EntityId>) {
            self.owner_id.set_if_changed(id);
        }

        pub fn rows(&self) -> Vec<{{ ent.pascal_name }}{{ lf.pascal_name }}Row> {
            (0..self.model.len())
                .filter_map(|i| self.model.with_item(i, |r| r.clone()))
                .collect()
        }

        pub fn len(&self) -> usize {
            self.model.len()
        }

        pub fn is_empty(&self) -> bool {
            self.len() == 0
        }

        pub fn row_at(&self, index: usize) -> Option<{{ ent.pascal_name }}{{ lf.pascal_name }}Row> {
            self.model.with_item(index, |r| r.clone())
        }

        /// No-op under mocks: a mocks build registers no event source, and
        /// `subscribe_event` panics without one.
        pub fn wire(&self, _ctx: &mut BuildContext) {}

        pub fn refresh(&self) {}
        {%- if target.owner_snake_name == ent.snake_name %}

        pub fn create(
            &self,
            _dto: &Create{{ target.pascal_name }}Dto,
            _index: i32,
            _stack_id: Option<u64>,
        ) -> Option<EntityId> {
            let id = {
                let mut next = self.next_id.borrow_mut();
                *next += 1;
                *next
            };
            self.model.push({{ ent.pascal_name }}{{ lf.pascal_name }}Row {
                id,
                {%- for f in target.normal_fields %}
                {%- if f.inner.field_type == "String" and not f.is_list and not f.optional %}
                {{ f.snake_name }}: format!("Mock {{ target.pascal_name }} {id}"),
                {%- endif %}
                {%- endfor %}
                ..Default::default()
            });
            self.version.set(self.version.get().wrapping_add(1));
            Some(id)
        }

        pub fn update(&self, row: &{{ ent.pascal_name }}{{ lf.pascal_name }}Row, _stack_id: Option<u64>) {
            let rows: Vec<_> = self
                .rows()
                .into_iter()
                .map(|r| if r.id == row.id { row.clone() } else { r })
                .collect();
            self.model.reconcile_by_key(rows, |r| r.id);
            self.version.set(self.version.get().wrapping_add(1));
        }

        pub fn remove(&self, id: EntityId, _stack_id: Option<u64>) {
            let rows: Vec<_> = self.rows().into_iter().filter(|r| r.id != id).collect();
            self.model.reconcile_by_key(rows, |r| r.id);
            self.version.set(self.version.get().wrapping_add(1));
        }
        {%- endif %}
        {%- if ordered %}

        pub fn move_to(&self, id: EntityId, new_index: i32, _stack_id: Option<u64>) {
            let mut rows = self.rows();
            if let Some(from) = rows.iter().position(|r| r.id == id) {
                let row = rows.remove(from);
                let to = (new_index.max(0) as usize).min(rows.len());
                rows.insert(to, row);
                self.model.reconcile_by_key(rows, |r| r.id);
                self.version.set(self.version.get().wrapping_add(1));
            }
        }
        {%- endif %}
    }
}


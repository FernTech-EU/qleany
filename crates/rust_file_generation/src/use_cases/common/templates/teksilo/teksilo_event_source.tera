//! Bridges the Qleany event hub to Teksilo's `EventSource`.
//!
//! The hub publishes from a background thread; Teksilo boxes each event and
//! posts it through the window event loop, so a widget's callback runs on the
//! UI thread and may touch `Signal`s and models freely.
//!
//! This is a newtype rather than an impl on `EventHubClient` because the orphan
//! rule forbids implementing a foreign trait for a foreign type.

use std::sync::Arc;

use teksilo::core::event_source::{EventSource, SubscriptionHandle};

use frontend::EventHubClient;
use frontend::common::event::{Event, Origin};

#[derive(Clone)]
pub struct QleanyEventSource {
    client: EventHubClient,
}

impl QleanyEventSource {
    pub fn new(client: EventHubClient) -> Self {
        Self { client }
    }
}

impl EventSource for QleanyEventSource {
    type Origin = Origin;
    type Event = Event;

    fn subscribe(
        &self,
        origin: Self::Origin,
        callback: Arc<dyn Fn(Self::Event) + Send + Sync + 'static>,
    ) -> SubscriptionHandle {
        // The returned token unsubscribes on drop, which is exactly the
        // contract `SubscriptionHandle` wants.
        SubscriptionHandle::new(self.client.subscribe(origin, move |event| callback(event)))
    }
}

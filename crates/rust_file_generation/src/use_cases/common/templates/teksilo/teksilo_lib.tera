//! Teksilo desktop UI for {{ s.global.inner.application_name }}.
//!
//! Layering: `frontend` (generated backend facade) -> `singles` / `models`
//! (reactive handles over it) -> `app` (widgets). The widget layer never calls
//! a command directly; it reads signals and calls the handles.

pub mod app;
pub mod event_source;
pub mod models;
pub mod session;
pub mod singles;
pub mod undo_redo;

use std::rc::Rc;

use teksilo::prelude::*;

use frontend::{AppContext, EventHubClient};

use crate::app::AppRoot;
use crate::event_source::QleanyEventSource;
use crate::session::Session;

/// Build and run the application. `src/main.rs` is a one-line call to this.
pub fn run() {
    env_logger::init();

    let app_ctx = Rc::new(AppContext::new());

    // Background dispatch thread. It exits when `AppContext::shutdown` drops the
    // shutdown sender.
    let client = EventHubClient::new(&app_ctx.event_hub);
    client.start(app_ctx.shutdown_rx.clone());

    let session = Session::new(app_ctx.clone());

    // The store starts empty and no widget creates an owner, so the demo's
    // lists would have nothing to hang off and its Add button would refuse
    // every click. Here and not in a widget's `build`: `build` reruns on every
    // rebuild, and a bootstrap that reran would mint a fresh root each frame.
    crate::app::bootstrap(&session);

    TeksiloAppBuilder::new()
        // There is no `Theme::default()`; a preset must be chosen.
        .theme(teksilo::presets::intui::light())
        // Registered once for the process, before any window:
        // `ctx.subscribe_event` panics when no source is registered.
        .event_source(QleanyEventSource::new(client))
        .initial_window(
            WindowConfig::new()
                .title("{{ s.global.inner.application_name }}")
                .size(1100, 700)
                .root(move |tree, _state| tree.add(AppRoot::new(session))),
        )
        .run();

    app_ctx.shutdown();
}

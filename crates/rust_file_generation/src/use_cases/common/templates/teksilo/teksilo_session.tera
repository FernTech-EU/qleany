// Generated by Qleany v{{ s.system.inner.version }} from {{ s.file.inner.template_name }}.tera
{#- ── Demo-entity election ────────────────────────────────────────────────
     Kept byte-for-byte in step with teksilo_app.tera: the window creates
     `demo_ent` through `list_ent`.`list_field`, so the hierarchy `bootstrap`
     has to build is exactly `demo_ent`'s ownership chain. Tera has no way to
     share `set_global` state across templates (an `include` renders in its own
     scope), so the election is repeated rather than factored out. -#}
{%- set_global demo_ent = false %}
{%- set_global list_ent = false %}
{%- set_global list_field = false %}
{%- for eid, ent in s.entities %}
  {%- if not demo_ent and not ent.inner.only_for_heritage %}
    {%- for f in ent.fields %}
      {%- if not demo_ent and f.inner.list_model and f.inner.entity and f.inner.strong %}
        {%- set target = s.entities[f.inner.entity] %}
        {%- set_global is_owner = false %}
        {%- if target.owner_snake_name == ent.snake_name %}{% set_global is_owner = true %}{% endif %}
        {%- set_global has_form_fields = false %}
        {%- for tf in target.normal_fields %}
          {%- if not tf.is_list and not tf.optional and tf.snake_name != "created_at" and tf.snake_name != "updated_at" %}
            {%- if tf.inner.field_type != "Enum" and tf.inner.field_type != "Entity" %}
              {%- set_global has_form_fields = true %}
            {%- endif %}
          {%- endif %}
        {%- endfor %}
        {%- if is_owner and has_form_fields and not target.inner.only_for_heritage %}
          {%- set_global list_ent = ent %}
          {%- set_global list_field = f %}
          {%- set_global demo_ent = target %}
        {%- endif %}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
{%- endfor %}
{#- A demo entity with an empty ownership chain has no hierarchy to build, and
    the election cannot produce one (it demands an owning holder), but the guard
    costs nothing and keeps a hand-edited manifest from generating a `bootstrap`
    whose body is a bare `return`. -#}
{%- set_global has_bootstrap = false %}
{%- if demo_ent %}
{%- if demo_ent.ownership_chain | length > 0 %}{% set_global has_bootstrap = true %}{% endif %}
{%- endif %}
{%- set_global chain_root = false %}
{%- if has_bootstrap %}
{%- set_global chain_root = demo_ent.ownership_chain | first %}
{%- endif %}

//! Everything the UI reads the backend through.
//!
//! One `AppContext`, one single per entity that asked for one, one list model
//! per relationship that asked for one, one undo/redo binder. `Clone` is a
//! handle clone: every clone sees the same singles and the same models.

use std::rc::Rc;

use teksilo::prelude::*;

use frontend::AppContext;
{#- Only the per-list owner signals name EntityId, so a manifest with no list
    model would import it unused. -#}
{%- set_global has_list_model = false %}
{%- for eid, ent in s.entities %}
{%- if not ent.inner.only_for_heritage %}
{%- for f in ent.fields %}
{%- if f.inner.list_model and f.inner.entity %}{% set_global has_list_model = true %}{% endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- if has_list_model %}
use frontend::EntityId;
{%- endif %}
{%- if has_bootstrap %}
use frontend::commands::undo_redo_commands;
use frontend::commands::{
    {%- for a in demo_ent.ownership_chain %}
    {{ a.snake_name }}_commands,
    {%- endfor %}
};
use frontend::direct_access::{
    {%- for a in demo_ent.ownership_chain %}
    Create{{ a.pascal_name }}Dto,
    {%- endfor %}
};
{%- endif %}

#[allow(unused_imports)]
use crate::models::*;
#[allow(unused_imports)]
use crate::singles::*;
use crate::undo_redo::UndoRedoBinder;

#[derive(Clone)]
pub struct Session {
    pub app_ctx: Rc<AppContext>,
    /// The stack every generated mutator is handed. `None` is the default
    /// stack; call `undo_redo_commands::create_new_stack` and store the result
    /// here for a per-document stack.
    pub stack_id: Option<u64>,
    pub undo_redo: UndoRedoBinder,
    {%- for eid, ent in s.entities %}
    {%- if ent.inner.single_model and not ent.inner.only_for_heritage %}
    pub single_{{ ent.snake_name }}: Single{{ ent.pascal_name }},
    {%- endif %}
    {%- endfor %}
    {%- for eid, ent in s.entities %}
    {%- if not ent.inner.only_for_heritage %}
    {%- for f in ent.fields %}
    {%- if f.inner.list_model and f.inner.entity %}
    pub {{ ent.snake_name }}_{{ f.snake_name }}: {{ ent.pascal_name }}{{ f.pascal_name }}ListModel,
    /// Which `{{ ent.pascal_name }}` the list above belongs to. `None` leaves the
    /// list empty; [`Session::bootstrap`] seeds the ones it can.
    pub {{ ent.snake_name }}_{{ f.snake_name }}_owner: Signal<Option<EntityId>>,
    {%- endif %}
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
}

impl Session {
    pub fn new(app_ctx: Rc<AppContext>) -> Self {
        {%- for eid, ent in s.entities %}
        {%- if not ent.inner.only_for_heritage %}
        {%- for f in ent.fields %}
        {%- if f.inner.list_model and f.inner.entity %}
        // Its own signal, never a shared one: sharing would re-point every list
        // at the same owner.
        let {{ ent.snake_name }}_{{ f.snake_name }}_owner: Signal<Option<EntityId>> = Signal::new(None);
        {%- endif %}
        {%- endfor %}
        {%- endif %}
        {%- endfor %}

        Self {
            undo_redo: UndoRedoBinder::new(app_ctx.clone(), None),
            {%- for eid, ent in s.entities %}
            {%- if ent.inner.single_model and not ent.inner.only_for_heritage %}
            single_{{ ent.snake_name }}: Single{{ ent.pascal_name }}::new(app_ctx.clone()),
            {%- endif %}
            {%- endfor %}
            {%- for eid, ent in s.entities %}
            {%- if not ent.inner.only_for_heritage %}
            {%- for f in ent.fields %}
            {%- if f.inner.list_model and f.inner.entity %}
            {{ ent.snake_name }}_{{ f.snake_name }}: {{ ent.pascal_name }}{{ f.pascal_name }}ListModel::new(
                app_ctx.clone(),
                {{ ent.snake_name }}_{{ f.snake_name }}_owner.clone(),
            ),
            {{ ent.snake_name }}_{{ f.snake_name }}_owner,
            {%- endif %}
            {%- endfor %}
            {%- endif %}
            {%- endfor %}
            stack_id: None,
            app_ctx,
        }
    }

{%- if has_bootstrap %}

    /// Create the owner hierarchy the demo window needs, then point the lists at
    /// it. Call once, from `run()`.
    ///
    /// The store starts empty. Nothing in the generated UI creates an owner, so
    /// without this walk every `*_owner` signal stays `None`, every list model
    /// refuses to create under a missing owner, and the demo's
    /// "Add {{ demo_ent.pascal_name }}" button is a silent no-op.
    ///
    /// **Never from a widget's `build`**: `build` reruns on every rebuild, and a
    /// bootstrap that reran would mint a fresh `{{ chain_root.pascal_name }}` tree
    /// each time. The early return below is a second line of defence, not a
    /// licence to move the call.
    ///
    /// The walk is `demo_ent`'s ownership chain, root first:
    /// {% for a in demo_ent.ownership_chain %}`{{ a.pascal_name }}`{% if not loop.last %} -> {% endif %}{% endfor %} -> `{{ demo_ent.pascal_name }}` (yours to add).
    pub fn bootstrap(&self) {
        // Scaffolding, not user work: a second call would mint a second
        // `{{ chain_root.pascal_name }}` and orphan everything already on screen.
        if self.{{ list_ent.snake_name }}_{{ list_field.snake_name }}_owner.get().is_some() {
            log::debug!("bootstrap: already done, skipping");
            return;
        }

        let now = chrono::Utc::now();
        {%- set_global prev_snake = "" %}
        {%- set_global prev_pascal = "" %}
        {%- for a in demo_ent.ownership_chain %}

        {%- if loop.first %}
        let {{ a.snake_name }}_id = match {{ a.snake_name }}_commands::create_orphan_{{ a.snake_name }}(
            &self.app_ctx,
            {%- if a.undoable %}
            self.stack_id,
            {%- endif %}
            // `..Default::default()` covers whatever else this entity carries;
            // the two timestamps are mandatory on every entity and are the one
            // pair a `Default` would leave at the epoch.
            &Create{{ a.pascal_name }}Dto {
                created_at: now,
                updated_at: now,
                ..Default::default()
            },
        ) {
            Ok(dto) => dto.id,
            Err(e) => {
                log::error!("bootstrap: could not create the top-level {{ a.pascal_name }}: {e}");
                return;
            }
        };
        {%- else %}
        let {{ a.snake_name }}_id = match {{ a.snake_name }}_commands::create_{{ a.snake_name }}(
            &self.app_ctx,
            {%- if a.undoable %}
            self.stack_id,
            {%- endif %}
            &Create{{ a.pascal_name }}Dto {
                created_at: now,
                updated_at: now,
                ..Default::default()
            },
            {{ prev_snake }}_id,
            0,
        ) {
            Ok(dto) => dto.id,
            Err(e) => {
                log::error!(
                    "bootstrap: could not create a {{ a.pascal_name }} under {{ prev_pascal }} \
                     #{% raw %}{{% endraw %}{{ prev_snake }}_id}: {e}"
                );
                return;
            }
        };
        {%- endif %}
        log::info!("bootstrap: created {{ a.pascal_name }} #{% raw %}{{% endraw %}{{ a.snake_name }}_id}");
        {%- set_global prev_snake = a.snake_name %}
        {%- set_global prev_pascal = a.pascal_name %}
        {%- endfor %}

        // Point every list whose owner the walk just created at that owner. A
        // list owned by something the walk does NOT create stays `None` on
        // purpose -- it is waiting for a selection, not broken.
        {%- for eid, ent in s.entities %}
        {%- if not ent.inner.only_for_heritage %}
        {%- for f in ent.fields %}
        {%- if f.inner.list_model and f.inner.entity %}
        {%- set_global owner_in_chain = false %}
        {%- for a in demo_ent.ownership_chain %}
        {%- if a.snake_name == ent.snake_name %}{% set_global owner_in_chain = true %}{% endif %}
        {%- endfor %}
        {%- if owner_in_chain %}
        self.{{ ent.snake_name }}_{{ f.snake_name }}_owner.set(Some({{ ent.snake_name }}_id));
        {%- else %}
        // `{{ ent.snake_name }}_{{ f.snake_name }}` hangs off a `{{ ent.pascal_name }}`, which this walk
        // does not create: seed it when one is selected or created.
        {%- endif %}
        {%- endif %}
        {%- endfor %}
        {%- endif %}
        {%- endfor %}

        // The hierarchy above is scenery, not something the user did. Leaving it
        // on the stack would open the app with Undo enabled and one click away
        // from deleting the {{ list_ent.pascal_name }} the list hangs off.
        // `UndoRedoBinder::wire` re-reads the manager on the first build, so this
        // is visible before anything is drawn.
        undo_redo_commands::clear_all_stacks(&self.app_ctx);
    }
{%- else %}

    /// Nothing to bootstrap.
    ///
    /// No relationship in this manifest elects a demo entity (see `app.rs` for
    /// what one looks like), so there is no owner hierarchy to build and no
    /// list-model owner to seed. Kept as a no-op so `run()` reads the same for
    /// every manifest.
    pub fn bootstrap(&self) {}
{%- endif %}

    /// Install every subscription.
    ///
    /// Call from a long-lived widget's `build`, **on every build** -- a
    /// `BuildContext` subscription is scoped to one build cycle and dropped on
    /// the next, so anything that wires once goes deaf after the first rebuild.
    pub fn wire_all(&self, ctx: &mut BuildContext) {
        self.undo_redo.wire(ctx);
        {%- for eid, ent in s.entities %}
        {%- if ent.inner.single_model and not ent.inner.only_for_heritage %}
        self.single_{{ ent.snake_name }}.wire(ctx);
        {%- endif %}
        {%- endfor %}
        {%- for eid, ent in s.entities %}
        {%- if not ent.inner.only_for_heritage %}
        {%- for f in ent.fields %}
        {%- if f.inner.list_model and f.inner.entity %}
        self.{{ ent.snake_name }}_{{ f.snake_name }}.wire(ctx);
        {%- endif %}
        {%- endfor %}
        {%- endif %}
        {%- endfor %}
        let _ = ctx;
    }
}

{%- set_global probe = f %}
{%- endif %}
{%- endfor %}
{%- for f in demo_ent.normal_fields %}
{%- if not probe and not f.is_list and not f.optional and f.snake_name != "created_at" and f.snake_name != "updated_at" and f.inner.field_type != "Enum" and f.inner.field_type != "Entity" %}
{%- set_global probe = f %}

//! `can_undo` / `can_redo` as live `Signal`s, plus the two verbs.
//!
//! The backend answers `can_undo` by asking the manager, which is a call and
//! not a signal, so this keeps a cached pair and refreshes them whenever the
//! undo/redo machinery announces a change.

use std::rc::Rc;

use teksilo::prelude::*;

use frontend::AppContext;
use frontend::commands::undo_redo_commands;
use frontend::common::event::{Event, Origin, UndoRedoEvent};

#[derive(Clone)]
pub struct UndoRedoBinder {
    ctx: Rc<AppContext>,
    stack_id: Option<u64>,
    can_undo: Signal<bool>,
    can_redo: Signal<bool>,
}

#[allow(dead_code)] // full surface; a generated app wires it up incrementally
impl UndoRedoBinder {
    pub fn new(ctx: Rc<AppContext>, stack_id: Option<u64>) -> Self {
        let can_undo = Signal::new(undo_redo_commands::can_undo(&ctx, stack_id));
        let can_redo = Signal::new(undo_redo_commands::can_redo(&ctx, stack_id));
        Self {
            ctx,
            stack_id,
            can_undo,
            can_redo,
        }
    }

    pub fn can_undo(&self) -> Signal<bool> {
        self.can_undo.clone()
    }

    pub fn can_redo(&self) -> Signal<bool> {
        self.can_redo.clone()
    }

    /// Stay live. Call from a long-lived widget's `build`, on every build --
    /// a `BuildContext` subscription lasts exactly one build cycle.
    ///
    /// `StackChanged` is not optional: without it nothing can learn that "can
    /// undo" just became *true*, because the manager otherwise announces only
    /// the consumption of history, never its creation.
    pub fn wire(&self, ctx: &mut BuildContext) {
        for event in [
            UndoRedoEvent::Undone,
            UndoRedoEvent::Redone,
            UndoRedoEvent::StackChanged,
        ] {
            let me = self.clone();
            ctx.subscribe_event(Origin::UndoRedo(event), move |_e: &Event| me.refresh());
        }
        self.refresh();
    }

    pub fn undo(&self) {
        if let Err(e) = undo_redo_commands::undo(&self.ctx, self.stack_id) {
            log::error!("undo failed: {e}");
        }
        self.refresh();
    }

    pub fn redo(&self) {
        if let Err(e) = undo_redo_commands::redo(&self.ctx, self.stack_id) {
            log::error!("redo failed: {e}");
        }
        self.refresh();
    }

    /// `set_if_changed`, for the same reason the list models bump their version
    /// conditionally: an unconditional write to a signal a widget binds at
    /// rebuild level is a build -> dirty -> rebuild loop at frame rate.
    fn refresh(&self) {
        self.can_undo
            .set_if_changed(undo_redo_commands::can_undo(&self.ctx, self.stack_id));
        self.can_redo
            .set_if_changed(undo_redo_commands::can_redo(&self.ctx, self.stack_id));
    }
}
